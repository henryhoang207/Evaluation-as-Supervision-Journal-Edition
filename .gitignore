# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.vite/

# Local datasets and generated files
backend/data/raw/*
backend/data/processed/*
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
*.sqlite
*.sqlite3
*.db
*.parquet
*.csv
*.jsonl

# ...except the study checkpoints. They carry observations[] — the measured
# facts and per-stage verdicts behind every number in the paper, and the whole
# Tier-1 defect bank. The blanket *.jsonl rule above is meant for generated eval
# scratch. Without this negation the repository tracked the .bak files recording
# *failed* runs while ignoring the results, and ~143 KB of irreplaceable data
# lived on one disk only.
!backend/out_study/**/*.jsonl

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local agent settings
.claude/
.codex/

# Local debug/trace scripts
backend/trace_agents.py
backend/trace_agents_live.py



.env.example

# eval CLI output artifacts (generated, not source)
backend/eval/**/tier1_report.json
backend/eval/**/tier2_scores.json
backend/eval/**/tier3_scores.json
# Track the local (Ollama) env profile alongside .env.example
!.env.local.example

# Paper drafts: TRACKED as of 2026-08-24 (journal edition repo is private).
# Build artefacts and local scratch inside docs/paper/ stay ignored.
docs/paper/*.bak
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.synctex.gz
